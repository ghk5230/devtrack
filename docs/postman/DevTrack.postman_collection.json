{
  "info": {
    "_postman_id": "4b38d7ce-3d99-4f1b-9a6c-devtrack",
    "name": "DevTrack API",
    "description": "Postman requests for the DevTrack Django API assignment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Create reporter",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"name\": \"Asha Rao\",\n  \"email\": \"asha@example.com\",\n  \"team\": \"backend\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/reporters/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reporters", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List all reporters",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/reporters/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reporters", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get reporter by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/reporters/?id=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "reporters", ""],
          "query": [
            {
              "key": "id",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Reporter ID is 1', function () { pm.expect(pm.response.json().id).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create critical issue",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Login button not working on mobile\",\n  \"description\": \"Users on iOS 17 cannot tap the login button\",\n  \"status\": \"open\",\n  \"priority\": \"critical\",\n  \"reporter_id\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/issues/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "issues", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', function () { pm.response.to.have.status(201); });",
              "pm.test('Critical message is present', function () { pm.expect(pm.response.json().message).to.include('[URGENT]'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List all issues",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/issues/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "issues", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get issue by ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/issues/?id=1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "issues", ""],
          "query": [
            {
              "key": "id",
              "value": "1"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Issue ID is 1', function () { pm.expect(pm.response.json().id).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List open issues",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/issues/?status=open",
          "host": ["{{baseUrl}}"],
          "path": ["api", "issues", ""],
          "query": [
            {
              "key": "status",
              "value": "open"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid issue title",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"description\": \"Missing title\",\n  \"status\": \"open\",\n  \"priority\": \"high\",\n  \"reporter_id\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/issues/",
          "host": ["{{baseUrl}}"],
          "path": ["api", "issues", ""]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400 Bad Request', function () { pm.response.to.have.status(400); });",
              "pm.test('Title validation error is present', function () { pm.expect(pm.response.json().error).to.eql('Title cannot be empty'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing issue",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/issues/?id=999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "issues", ""],
          "query": [
            {
              "key": "id",
              "value": "999"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404 Not Found', function () { pm.response.to.have.status(404); });",
              "pm.test('Not-found error is present', function () { pm.expect(pm.response.json().error).to.eql('Issue not found'); });"
            ]
          }
        }
      ]
    }
  ]
}
